GITHUB_TOKEN=github_pat_REPLACE_ME
# Optional read-only discovery token; include private repos to scan.
# Falls back to GITHUB_TOKEN when empty.
GITHUB_READ_TOKEN=
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4.1-mini
GITHUB_OWNER=MDalprato
PROFILE_REPO=MDalprato/MDalprato
PROFILE_BRANCH=main
TIMEZONE=Europe/Rome
SCHEDULE_DAY=mon
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
LOOKBACK_DAYS=90
MAX_PUBLIC_REPOS=30
DRY_RUN=true
# true commits validated updates directly to PROFILE_BRANCH; false opens draft PRs.
# DRY_RUN=true or --dry-run always prevents GitHub writes.
AUTO_PUSH=false
PRIVATE_SCAN=true
MIN_CHANGE_CHARS=35

# Opt in to sharing aggregated private language names with OpenAI and the profile.
PRIVATE_LANGUAGES_FOR_PROFILE=false
